const routes = `import { Router } from 'express';
import { websiteController } from '../controllers/websiteController';

const router = Router();

router.post('/analyze', (req, res) => websiteController.analyze(req, res));
router.post('/generate', (req, res) => websiteController.generate(req, res));
router.get('/projects', (req, res) => websiteController.listProjects(req, res));
router.get('/projects/:id', (req, res) => websiteController.getProject(req, res));
router.get('/:id/demo', (req, res) => websiteController.getDemo(req, res));
router.get('/preview/:slug', (req, res) => websiteController.getDemoBySlug(req, res));

export default router;
`;

writeFile('src/routes/websiteRoutes.ts', routes);

