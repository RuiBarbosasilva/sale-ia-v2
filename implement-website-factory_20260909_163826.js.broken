console.log('[12/15] Criando testes...');

const testCode = `import request from 'supertest';
import { app } from '../src/app';
import { PrismaClient } from '@prisma/client';

const prisma = new PrismaClient();

describe('Website AI Factory', () => {
  let prospectId: string;
  let projectId: string;
  let projectSlug: string;

  beforeAll(async () => {
    await prisma.websiteProject.deleteMany();
    await prisma.websiteProspect.deleteMany();
  });

  afterAll(async () => {
    await prisma.\$disconnect();
  });

  describe('POST /api/websites/analyze', () => {
    it('deve analisar um prospect', async () => {
      const prospect = await prisma.websiteProspect.create({
        data: {
          companyName: 'Test Clinic',
          segment: 'clinica',
          city: 'SÃ£o Paulo',
          state: 'SP',
          phone: '11999999999',
          websiteStatus: 'NO_WEBSITE',
          status: 'DISCOVERED'
        }
      });
      prospectId = prospect.id;

      const res = await request(app)
        .post('/api/websites/analyze')
        .send({ prospectId });

      expect(res.status).toBe(200);
      expect(res.body.success).toBe(true);
      expect(res.body.analysis).toBeDefined();
      expect(res.body.analysis.recommendedCreator).toBe('clinic');
    });
  });

  describe('POST /api/websites/generate', () => {
    it('deve gerar um website demo', async () => {
      const res = await request(app)
        .post('/api/websites/generate')
        .send({ prospectId });

      expect(res.status).toBe(200);
      expect(res.body.success).toBe(true);
      expect(res.body.projectId).toBeDefined();
      expect(res.body.previewUrl).toBeDefined();
      
      projectId = res.body.projectId;
      projectSlug = res.body.previewUrl.split('/').pop();
    });
  });

  describe('GET /api/websites/:id/demo', () => {
    it('deve retornar HTML do demo', async () => {
      const res = await request(app)
        .get('/api/websites/' + projectId + '/demo');

      expect(res.status).toBe(200);
      expect(res.text).toContain('<!DOCTYPE html>');
      expect(res.text).toContain('Test Clinic');
    });
  });

  describe('GET /api/websites/preview/:slug', () => {
    it('deve retornar HTML pelo slug', async () => {
      const res = await request(app)
        .get('/api/websites/preview/' + projectSlug);

      expect(res.status).toBe(200);
      expect(res.text).toContain('<!DOCTYPE html>');
    });
  });

  describe('GET /api/websites/projects', () => {
    it('deve listar projetos', async () => {
      const res = await request(app)
        .get('/api/websites/projects');

      expect(res.status).toBe(200);
      expect(res.body.success).toBe(true);
      expect(Array.isArray(res.body.projects)).toBe(true);
    });
  });
});
`;

writeFile('tests/website-factory.test.ts', testCode);

