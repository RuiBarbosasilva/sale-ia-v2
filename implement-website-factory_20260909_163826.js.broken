const websiteTypes = `export interface WebsiteAnalysis {
  websiteQualityScore: number;
  digitalPresenceScore: number;
  opportunityScore: number;
  hasWebsite: boolean;
  websiteStatus: 'NO_WEBSITE' | 'POOR' | 'AVERAGE' | 'GOOD' | 'EXCELLENT';
  hasWhatsApp: boolean;
  hasContactForm: boolean;
  hasCTA: boolean;
  isMobileFriendly: boolean;
  hasSSL: boolean;
  issues: string[];
  recommendations: string[];
}

export interface DesignTokens {
  primaryColor: string;
  secondaryColor: string;
  accentColor: string;
  fontFamily: string;
  headingFont: string;
  borderRadius: string;
  shadow: string;
  spacing: {
    xs: string;
    sm: string;
    md: string;
    lg: string;
    xl: string;
  };
}

export interface WebsiteBlueprint {
  siteType: string;
  creatorType: string;
  pages: string[];
  sections: string[];
  features: string[];
}

export interface WebsiteContent {
  heroHeadline: string;
  heroSubtitle: string;
  ctaText: string;
  aboutText: string;
  services: Array<{ title: string; description: string }>;
  benefits: Array<{ title: string; description: string }>;
  faq: Array<{ question: string; answer: string }>;
  metaTitle: string;
  metaDescription: string;
}

export interface WebsiteGenerationResult {
  success: boolean;
  projectId?: string;
  demoUrl?: string;
  previewUrl?: string;
  version: number;
  score: number;
  errors?: string[];
}

export type CreatorType = 
  | 'premium'
  | 'local-business'
  | 'conversion'
  | 'clinic'
  | 'restaurant'
  | 'professional'
  | 'service'
  | 'ecommerce';

export interface CreatorConfig {
  type: CreatorType;
  segments: string[];
  designTokens: DesignTokens;
  defaultSections: string[];
}
`;

writeFile('src/types/website.ts', websiteTypes);

