const creatorSelector = `import { CreatorType } from '../types/website';

export class CreatorSelector {
  private segmentMap: Record<string, CreatorType> = {
    'clinica': 'clinic',
    'clÃ­nica': 'clinic',
    'odontologia': 'clinic',
    'dentista': 'clinic',
    'mÃ©dico': 'clinic',
    'saÃºde': 'clinic',
    'restaurante': 'restaurant',
    'lanchonete': 'restaurant',
    'pizzaria': 'restaurant',
    'cafeteria': 'restaurant',
    'bar': 'restaurant',
    'advogado': 'professional',
    'advocacia': 'professional',
    'escritÃ³rio': 'professional',
    'contabilidade': 'professional',
    'contador': 'professional',
    'consultoria': 'professional',
    'salÃ£o': 'service',
    'salao': 'service',
    'barbearia': 'service',
    'estetica': 'service',
    'estÃ©tica': 'service',
    'loja': 'ecommerce',
    'ecommerce': 'ecommerce',
    'e-commerce': 'ecommerce',
    'varejo': 'ecommerce',
    'academia': 'service',
    'pet shop': 'service',
    'petshop': 'service',
    'imobiliÃ¡ria': 'professional',
    'imobiliaria': 'professional',
    'hotel': 'premium',
    'pousada': 'premium',
    'resort': 'premium',
    'spa': 'premium',
    'construtora': 'professional',
    'arquiteto': 'professional',
    'engenharia': 'professional'
  };

  selectCreator(segment: string, hasWebsite: boolean, websiteScore?: number): CreatorType {
    const normalizedSegment = segment.toLowerCase().trim();
    
    // Verificar mapeamento direto
    for (const [key, creator] of Object.entries(this.segmentMap)) {
      if (normalizedSegment.includes(key)) {
        return creator;
      }
    }

    // Se tem site com score alto, usar premium
    if (hasWebsite && websiteScore && websiteScore >= 70) {
      return 'premium';
    }

    // Default: local-business
    return 'local-business';
  }

  getCreatorDescription(creatorType: CreatorType): string {
    const descriptions: Record<CreatorType, string> = {
      'clinic': 'Criador especializado em clÃ­nicas e profissionais de saÃºde',
      'restaurant': 'Criador especializado em restaurantes e gastronomia',
      'professional': 'Criador especializado em serviÃ§os profissionais e B2B',
      'service': 'Criador especializado em serviÃ§os locais',
      'ecommerce': 'Criador especializado em lojas e e-commerce',
      'local-business': 'Criador genÃ©rico para empresas locais',
      'conversion': 'Criador focado em conversÃ£o e landing pages',
      'premium': 'Criador para empresas de alto padrÃ£o'
    };
    return descriptions[creatorType];
  }
}

export const creatorSelector = new CreatorSelector();
`;

writeFile('src/services/website/creatorSelector.ts', creatorSelector);

