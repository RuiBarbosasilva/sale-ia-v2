PORT=3000
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# Copie este arquivo para .env. Nunca coloque os valores reais no GitHub.
# Em producao, cadastre os mesmos valores no gerenciador de secrets da hospedagem.

# RB Factory Sites - prospeccao
# ATENCAO: o adaptador atual chama endpoints Places Legacy. Antes de usar uma chave nova do Places API (New),
# atualize o adaptador do projeto para a API New (endpoints e FieldMask sao diferentes).
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_LANGUAGE=pt-BR
GOOGLE_PLACES_REGION=BR
GOOGLE_PLACES_MAX_RESULTS=50
GOOGLE_PLACES_TIMEOUT_MS=15000

# Provedores de IA do Site Factory
# Comece pelo Gemini. Qwen e OpenAI sao alternativas; Qwen exige tambem o endpoint regional.
WEBSITE_AI_PROVIDER_ORDER=gemini,qwen,openai
GEMINI_API_KEY=
GEMINI_WEBSITE_MODEL=gemini-2.0-flash
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_WEBSITE_MODEL=qwen-plus
OPENAI_API_KEY=
OPENAI_WEBSITE_MODEL=gpt-4o-mini

# Seguranca administrativa interna
SALE_IA_ADMIN_KEY=
AFFILIATE_ADMIN_KEY=
AFFILIATE_WEBHOOK_KEY=
PAYMENT_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_SECRET=

# Criptografia de credenciais - gerar localmente; nunca reutilizar a mesma chave entre modulos
# AFFILIATE_CREDENTIALS_KEY: 64 caracteres hexadecimais (32 bytes).
AFFILIATE_CREDENTIALS_KEY=
# SOCIAL_MEDIA_TOKEN_ENCRYPTION_KEY: 64 caracteres hexadecimais (32 bytes) ou Base64 equivalente.
SOCIAL_MEDIA_TOKEN_ENCRYPTION_KEY=
# O codigo atual do Mercado Livre requer pelo menos 32 caracteres para esta chave.
MERCADO_LIVRE_TOKEN_ENCRYPTION_KEY=

# Mercado Livre - OAuth de vendedor
MERCADO_LIVRE_APP_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_REDIRECT_URI=https://SEU-DOMINIO/api/mercadolivre/auth/callback
MERCADO_LIVRE_ADMIN_KEY=
MERCADOLIVRE_SITE_ID=MLB
MERCADOLIVRE_API_BASE_URL=https://api.mercadolibre.com
MERCADOLIVRE_ENVIRONMENT=production

# Shopee - placeholders apenas; adaptador oficial ainda nao foi implementado no Sale-IA
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=

# Dropshipping - pesquisa publica do catalogo Mercado Livre
DROPSHIPPING_AUTORESEARCH_ENABLED=false
DROPSHIPPING_AUTORESEARCH_TICK_MS=60000
DROPSHIPPING_TREND_CATEGORY_IDS=

# RB Factory Sites - publicacao Netlify
NETLIFY_AUTH_TOKEN=
RB_FACTORY_AUTONOMY_ENABLED=false

# Blog Factory - usa OPENAI_API_KEY no servico atual
BLOG_FACTORY_FEEDS=
BLOG_FACTORY_AI_ENABLED=false
BLOG_FACTORY_AUTORUN_ENABLED=false
BLOG_FACTORY_INTERVAL_MS=21600000
BLOG_FACTORY_MAX_ARTICLES_PER_CYCLE=3
BLOG_FACTORY_AI_MODEL=gpt-4o-mini
BLOG_FACTORY_WORDPRESS_URL=https://SEU-BLOG.com
BLOG_FACTORY_WORDPRESS_USERNAME=
BLOG_FACTORY_WORDPRESS_APP_PASSWORD=

# WhatsApp - Evolution API (nomes EVOLUTION_* sao os lidos pelo servico atual)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=sale-ia

# E-mail de prospeccao (provider SMTP principal)
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=

# E-mail legado (emailService.ts ainda le SMTP_*; manter ate unificar os dois servicos)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Redis - necessario para BullMQ/filas no servidor; usar URL do Redis gerenciado na hospedagem
REDIS_URL=redis://localhost:6379

# Social Media Factory - um callback compartilhado para os provedores OAuth
SOCIAL_MEDIA_FACTORY_ENABLED=false
SOCIAL_MEDIA_DRY_RUN=true
SOCIAL_MEDIA_AI_MODEL=gpt-4.1-mini
SOCIAL_MEDIA_OAUTH_REDIRECT_URI=https://SEU-DOMINIO/api/social-media-factory/oauth/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PUBLIC_BASE_URL=https://SEU-DOMINIO
SOCIAL_MEDIA_IMAGE_GENERATION_ENABLED=false
SOCIAL_MEDIA_IMAGE_MODEL=gpt-image-1
SOCIAL_MEDIA_VIDEO_GENERATION_ENABLED=false
SOCIAL_MEDIA_MEDIA_ALLOWED_HOSTS=SEU-DOMINIO
SOCIAL_MEDIA_YOUTUBE_PRIVACY=private
SOCIAL_MEDIA_YOUTUBE_MAX_BYTES=524288000
FFMPEG_PATH=ffmpeg
PYTHON_PATH=python

# Motor de imagens para sites - opcionais; Openverse e Wikimedia sao alternativas sem chave
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
OPENAI_IMAGE_ENABLED=false
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_OUTPUT_DIR=storage/generated-images
OPENAI_IMAGE_PUBLIC_BASE_URL=/generated-images

# Canva - o modulo atual ainda nao conclui OAuth/refresh; nao preencher CANVA_ACCESS_TOKEN ate essa integracao ser finalizada
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_ACCESS_TOKEN=

# ElevenLabs - opcional; manter vazio ate habilitar o recurso de audio correspondente
ELEVENLABS_API_KEY=

# PIX - preencher somente com a chave real da empresa depois que a integracao de cobranca for validada
PIX_KEY=
PIX_NAME=
PIX_CITY=