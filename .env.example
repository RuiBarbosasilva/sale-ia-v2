PORT=3000
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# PIX Config
PIX_KEY="suachavepix@dominio.com"
PIX_NAME="NOME DA EMPRESA"
PIX_CITY="SAO PAULO"

# AI Credentials
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# WhatsApp API
WHATSAPP_API_URL="http://localhost:8080"
WHATSAPP_API_KEY=""
WHATSAPP_INSTANCE_NAME="sale-ia"

# Redis
REDIS_URL=redis://localhost:6379

# Mercado Livre
MERCADOLIVRE_APP_ID=your_app_id_here
MERCADOLIVRE_CLIENT_SECRET=your_client_secret_here
MERCADOLIVRE_REDIRECT_URI=https://yourdomain.com/api/mercadolivre/auth/callback
MERCADOLIVRE_SITE_ID=MLB
MERCADOLIVRE_API_BASE_URL=https://api.mercadolibre.com
MERCADOLIVRE_ENVIRONMENT=production

# Internal SALE-IA administration
# Prefer a dedicated key for internal dashboards and protected business operations.
SALE_IA_ADMIN_KEY="replace-with-a-long-random-secret"

# Affiliate module
# Hotmart credentials are stored encrypted through /api/affiliate-networks/:id/credentials.
# Expected credential JSON keys: clientId, clientSecret (or accessToken for an existing token).
# NEVER commit the real values to Git.
AFFILIATE_ADMIN_KEY="replace-with-a-long-random-secret"
AFFILIATE_WEBHOOK_KEY="replace-with-a-different-long-random-secret"

# 64 hex chars = 32-byte AES-256 key. Generate locally; never commit the real key.
AFFILIATE_CREDENTIALS_KEY="replace-with-64-hex-character-secret"


# Website Image Engine
# Pexels/Unsplash are optional API sources. Openverse and Wikimedia Commons work as free fallbacks.
PEXELS_API_KEY=""
UNSPLASH_ACCESS_KEY=""
OPENAI_IMAGE_ENABLED="false"

# RB Factory Sites - Vendedor IA / canais comerciais
# Contatos do proprietário para alertas e handoff. NÃO coloque credenciais ou tokens aqui.
RB_FACTORY_OWNER_WHATSAPP="5535998006332"
RB_FACTORY_OWNER_EMAIL="rui.barbosa.negocios@gmail.com"

# WhatsApp oficial/provider (credenciais reais devem ficar no ambiente/Secrets, nunca no Git)
RB_FACTORY_WHATSAPP_PROVIDER="evolution"
EVOLUTION_API_URL=""
EVOLUTION_INSTANCE=""
EVOLUTION_API_KEY=""
RB_FACTORY_WHATSAPP_OUTREACH_AUTHORIZED="false"
RB_FACTORY_WHATSAPP_AUTOSEND="false"

# E-mail do Vendedor IA
RB_FACTORY_EMAIL_PROVIDER="gmail"
RB_FACTORY_EMAIL_SENDER="rui.barbosa.negocios@gmail.com"
