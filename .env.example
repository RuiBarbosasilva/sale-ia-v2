PORT=3000
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# PIX Config
PIX_KEY="suachavepix@dominio.com"
PIX_NAME="NOME DA EMPRESA"
PIX_CITY="SAO PAULO"

# AI Credentials
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# WhatsApp API
WHATSAPP_API_URL="http://localhost:8080"
WHATSAPP_API_KEY=""
WHATSAPP_INSTANCE_NAME="sale-ia"

# Redis
REDIS_URL=redis://localhost:6379

# Mercado Livre
MERCADO_LIVRE_APP_ID=your_app_id_here
MERCADO_LIVRE_CLIENT_SECRET=your_client_secret_here
MERCADO_LIVRE_REDIRECT_URI=https://yourdomain.com/api/mercadolivre/auth/callback
MERCADOLIVRE_SITE_ID=MLB
MERCADOLIVRE_API_BASE_URL=https://api.mercadolibre.com
MERCADOLIVRE_ENVIRONMENT=production

# Shopee Open Platform (adapter not yet implemented; placeholders only)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=

# Dropshipping catalog research automation (opt-in; public Mercado Livre catalog only)
DROPSHIPPING_AUTORESEARCH_ENABLED="false"
# Worker checks due watches every 60 seconds (minimum 15 seconds, maximum 5 minutes)
DROPSHIPPING_AUTORESEARCH_TICK_MS=60000
# Optional category IDs for weekly authenticated Trends API snapshots (comma/semicolon separated).
# Example: MLB1430,MLB5672. Empty means site-wide trends only.
DROPSHIPPING_TREND_CATEGORY_IDS=

# Internal SALE-IA administration
# Prefer a dedicated key for internal dashboards and protected business operations.
SALE_IA_ADMIN_KEY="replace-with-a-long-random-secret"

# Affiliate module
# Hotmart credentials are stored encrypted through /api/affiliate-networks/:id/credentials.
# Expected credential JSON keys: clientId, clientSecret (or accessToken for an existing token).
# NEVER commit the real values to Git.
AFFILIATE_ADMIN_KEY="replace-with-a-long-random-secret"
AFFILIATE_WEBHOOK_KEY="replace-with-a-different-long-random-secret"

# 64 hex chars = 32-byte AES-256 key. Generate locally; never commit the real key.
AFFILIATE_CREDENTIALS_KEY="replace-with-64-hex-character-secret"


# RB Factory Sites
# In production, set true to start the commercial autonomy loop automatically with the server.
RB_FACTORY_AUTONOMY_ENABLED="false"
# Netlify personal/team access token used only by the server; never commit the real value.
NETLIFY_AUTH_TOKEN=""

# Website Image Engine
# Pexels/Unsplash are optional API sources. Openverse and Wikimedia Commons work as free fallbacks.
PEXELS_API_KEY=""
UNSPLASH_ACCESS_KEY=""
OPENAI_IMAGE_ENABLED="false"

# Social Media Factory IA (opt-in)
SOCIAL_MEDIA_FACTORY_ENABLED="false"
SOCIAL_MEDIA_AI_MODEL="gpt-4.1-mini"
SOCIAL_MEDIA_TOKEN_ENCRYPTION_KEY=""
SOCIAL_MEDIA_OAUTH_REDIRECT_URI="https://seu-dominio.com/api/social-media-factory/oauth/callback"
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_API_VERSION="v23.0"
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
PUBLIC_BASE_URL="https://seu-dominio.com"
SOCIAL_MEDIA_IMAGE_GENERATION_ENABLED="false"
SOCIAL_MEDIA_IMAGE_MODEL="gpt-image-1"
SOCIAL_MEDIA_VIDEO_GENERATION_ENABLED="false"
SOCIAL_MEDIA_MEDIA_ALLOWED_HOSTS=""
SOCIAL_MEDIA_YOUTUBE_PRIVACY="private"
FFMPEG_PATH="ffmpeg"
PYTHON_PATH="python"
ELEVENLABS_API_KEY=""
