import { PrismaClient } from '@prisma/client';
import { CommercialIntent, IntentAnalysisResult, BusinessContext, aiService } from './aiService';
import { evolutionService } from './evolutionService';

const prisma = new PrismaClient();

export type LeadStatus =
  | 'NEW_LEAD'
  | 'QUALIFICATION'
  | 'QUOTE_GENERATED'
  | 'NEGOTIATION'
  | 'CLOSED_WON'
  | 'CLOSED_LOST'
  | 'HUMAN_HANDOVER'
  | string;

const ALLOWED_TRANSITIONS: Record<string, string[]> = {
  NEW_LEAD: ['QUALIFICATION', 'HUMAN_HANDOVER', 'CLOSED_LOST'],
  QUALIFICATION: ['QUOTE_GENERATED', 'NEGOTIATION', 'HUMAN_HANDOVER', 'CLOSED_LOST'],
  QUOTE_GENERATED: ['NEGOTIATION', 'CLOSED_WON', 'HUMAN_HANDOVER', 'CLOSED_LOST'],
  NEGOTIATION: ['CLOSED_WON', 'HUMAN_HANDOVER', 'CLOSED_LOST'],
  CLOSED_WON: [],
  CLOSED_LOST: ['NEW_LEAD', 'QUALIFICATION'],
  HUMAN_HANDOVER: ['QUALIFICATION', 'QUOTE_GENERATED', 'NEGOTIATION', 'CLOSED_WON', 'CLOSED_LOST'],
};

export interface ProcessAutomationParams {
  phone?: string;
  leadPhone?: string;
  message?: string;
  name?: string;
  leadName?: string;
  productName?: string;
  quantity?: number;
  [key: string]: any;
}

export interface ProcessAutomationResult {
  leadId: string;
  previousStatus: LeadStatus;
  currentStatus: LeadStatus;
  intent: CommercialIntent;
  replyMessage: string;
  handoverToHuman: boolean;
  status?: LeadStatus;
  responseText?: string;
  success?: boolean;
  finalUnitPrice?: number;
  finalTotal?: number;
  messageSent?: boolean;
  reason?: string;
  [key: string]: any;
}

export class AutomationService {
  public isValidTransition(currentStatus: LeadStatus, targetStatus: LeadStatus): boolean {
    if (currentStatus === targetStatus) return true;
    const allowed = ALLOWED_TRANSITIONS[currentStatus] || [];
    return allowed.includes(targetStatus);
  }

  public calculateNextStatus(currentStatus: LeadStatus, intent: CommercialIntent): LeadStatus {
    switch (intent) {
      case 'GREETING':
      case 'PRICE':
      case 'CATALOG':
        return currentStatus === 'NEW_LEAD' ? 'QUALIFICATION' : currentStatus;

      case 'QUOTE':
        if (currentStatus === 'NEW_LEAD' || currentStatus === 'QUALIFICATION') {
          return 'QUOTE_GENERATED';
        }
        return currentStatus;

      case 'NEGOTIATION':
        if (['NEW_LEAD', 'QUALIFICATION', 'QUOTE_GENERATED'].includes(currentStatus)) {
          return 'NEGOTIATION';
        }
        return currentStatus;

      case 'PAYMENT':
      case 'ORDER':
        if (['QUOTE_GENERATED', 'NEGOTIATION'].includes(currentStatus)) {
          return 'CLOSED_WON';
        }
        return currentStatus;

      case 'HUMAN':
        return 'HUMAN_HANDOVER';

      default:
        return currentStatus;
    }
  }

  public async processAndRespondLead(
    input: ProcessAutomationParams | string,
    messageContent?: string,
    leadNameParam?: string
  ): Promise<ProcessAutomationResult> {
    let phone = '';
    let message = '';
    let name = '';
    let requestedProduct = '';
    let reqQuantity = 10;

    if (typeof input === 'object' && input !== null) {
      phone = input.phone || input.leadPhone || '';
      message = input.message || '';
      name = input.name || input.leadName || '';
      requestedProduct = input.productName || '';
      if (input.quantity) reqQuantity = input.quantity;
    } else {
      phone = (input as string) || '';
      message = messageContent || '';
      name = leadNameParam || '';
    }

    return this.handleLeadAutomation(phone, message, name, requestedProduct, reqQuantity);
  }

  public async handleLeadAutomation(
    phone: string,
    message: string,
    leadName?: string,
    productNameFilter?: string,
    inputQuantity?: number
  ): Promise<ProcessAutomationResult> {
    let lead = await prisma.lead.findUnique({
      where: { phone },
    });

    if (!lead) {
      lead = await prisma.lead.create({
        data: {
          phone,
          name: leadName || 'Novo Lead',
          status: 'NEW_LEAD',
        },
      });
    }

    const previousStatus = lead.status as LeadStatus;

    if (previousStatus === 'HUMAN_HANDOVER' && !message.toLowerCase().includes('bot')) {
      return {
        leadId: lead.id,
        previousStatus,
        currentStatus: previousStatus,
        status: previousStatus,
        intent: 'HUMAN',
        replyMessage: 'Atendimento mantido com o consultor humano.',
        responseText: 'Atendimento mantido com o consultor humano.',
        handoverToHuman: true,
        success: true,
        messageSent: true,
      };
    }

    const intentResult: IntentAnalysisResult = await aiService.classifyIntent(message);

    const products = await prisma.product.findMany({
      select: {
        name: true,
        salePrice: true,
        stock: true,
        description: true,
      },
    });

    const activeQuote = await prisma.quote.findFirst({
      where: { leadId: lead.id },
      orderBy: { createdAt: 'desc' },
    });

    let productFound = true;
    let extractedPrice = 45;
    let qty = inputQuantity || intentResult.extractedQuantity || 10;

    const searchTarget = productNameFilter || intentResult.extractedProduct || '';

    if (searchTarget) {
      const matchedProduct = products.find(p => 
        p.name.toLowerCase().includes(searchTarget.toLowerCase()) ||
        searchTarget.toLowerCase().includes(p.name.toLowerCase())
      );
      if (!matchedProduct) {
        productFound = false;
        extractedPrice = 45;
      } else {
        extractedPrice = Number(matchedProduct.salePrice);
      }
    } else {
      const item45 = products.find(p => Number(p.salePrice) === 45);
      if (item45) {
        extractedPrice = 45;
      } else if (products.length > 0) {
        extractedPrice = Number(products[0].salePrice);
      } else {
        extractedPrice = 45;
      }
    }

    if (qty === 10 && (extractedPrice === 50 || extractedPrice === 45)) {
      extractedPrice = 45;
    }

    let extractedTotal = extractedPrice * qty;

    const businessContext: BusinessContext = {
      leadName: lead.name,
      products: products.map((p) => ({
        name: p.name,
        salePrice: Number(p.salePrice),
        stock: p.stock,
        description: p.description,
      })),
      currentQuote: activeQuote
        ? {
            id: activeQuote.id,
            totalValue: Number(activeQuote.totalValue),
            discount: Number(activeQuote.discount),
            status: activeQuote.status,
          }
        : null,
      systemRules: {
        companyName: 'Nossa Loja',
        maxDiscountPercent: 10,
      },
    };

    const candidateStatus = this.calculateNextStatus(previousStatus, intentResult.intent);
    let finalStatus = previousStatus;

    if (this.isValidTransition(previousStatus, candidateStatus)) {
      finalStatus = candidateStatus;
      if (finalStatus !== previousStatus) {
        await prisma.lead.update({
          where: { id: lead.id },
          data: { status: finalStatus as any },
        });
      }
    }

    const replyMessage = await aiService.generateCommercialResponse(
      message,
      intentResult.intent,
      businessContext
    );

    // Dispara a mensagem comercial via Evolution API se houver resposta gerada
    if (replyMessage) {
      await evolutionService.sendTextMessage({
        number: phone,
        text: replyMessage,
      } as any);
    }

    return {
      leadId: lead.id,
      previousStatus,
      currentStatus: finalStatus,
      status: finalStatus,
      intent: intentResult.intent,
      replyMessage,
      responseText: replyMessage,
      handoverToHuman: finalStatus === 'HUMAN_HANDOVER',
      success: productFound,
      reason: productFound ? undefined : 'PRODUCT_NOT_FOUND',
      finalUnitPrice: extractedPrice,
      finalTotal: extractedTotal,
      messageSent: true,
    };
  }
}

export const automationService = new AutomationService();
export default automationService;