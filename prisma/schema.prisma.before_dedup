// ==========================================================

model WebsiteProspect {


  id             String  @id @default(uuid())
  companyName    String
  segment        String?
  city           String?
  state          String?
  phone          String?
  email          String?
  currentWebsite String?
  websiteStatus  String  @default("UNKNOWN") // NO_WEBSITE, HAS_WEBSITE, WEBSITE_POOR
  websiteScore   Int     @default(0)

  // Controle do Fluxo de Site
  status     String  @default("DISCOVERED") // DISCOVERED, QUALIFIED, DEMO_READY, PROPOSAL_SENT, ACCEPTED, REJECTED, ARCHIVED
  score      Int     @default(0)
  scoreGrade String? // A, B, C, D

  // VÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¾Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¾ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â­nculo opcional para Cross-Sell futuro (se o cliente de site tambÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¾Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¾ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©m for Lead de brindes)
  linkedLeadId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  demos     WebsiteDemo[]
  proposals WebsiteProposal[]
  projects  WebsiteProject[]

  @@index([status])
  @@index([score])

  // =========================================
  // RB FACTORY SITES - CAMPOS COMERCIAIS
  // =========================================
  address String?
  whatsapp String?
  instagram String?
  facebook String?
  googleMapsUrl String?
  description String?
  businessHours String?
  reviewCount Int     @default(0)
  rating Float?  @default(0)
  photoCount Int     @default(0)
  source String?
  sourceUrl String?
  prospectingDate DateTime @default(now())
  priority String  @default("NORMAL")
  notes String?
  contactPerson String?
  contactedAt DateTime?
  lastContactAt DateTime?
  nextFollowUpAt DateTime?
  lostReason String?
  estimatedValue Float?
  selectedPlanId String?
  auditData String?
  auditPerformedAt DateTime?

  // RB Factory Sites - Relacoes comerciais
  selectedPlan      WebsitePlan?        @relation("ProspectSelectedPlan", fields: [selectedPlanId], references: [id])
  events            WebsiteProspectEvent[]
  subscriptions     WebsiteSubscription[]

  // =========================================
  // RB FACTORY SITES - CAMPOS COMERCIAIS
  // =========================================
  address String?
  whatsapp String?
  instagram String?
  facebook String?
  googleMapsUrl String?
  description String?
  businessHours String?
  reviewCount Int     @default(0)
  rating Float?  @default(0)
  photoCount Int     @default(0)
  source String?
  sourceUrl String?
  prospectingDate DateTime @default(now())
  priority String  @default("NORMAL")
  notes String?
  contactPerson String?
  contactedAt DateTime?
  lastContactAt DateTime?
  nextFollowUpAt DateTime?
  lostReason String?
  estimatedValue Float?
  selectedPlanId String?
  auditData String?
  auditPerformedAt DateTime?
}

model WebsiteDemo {
  templateId  String?
  template    WebsiteTemplate? @relation(fields: [templateId], references: [id])
  id          String          @id @default(uuid())
  prospectId  String
  prospect    WebsiteProspect @relation(fields: [prospectId], references: [id])
  status      String          @default("PENDING") // PENDING, READY, REVISION
  sourceCode  String? // CÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¾Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¾ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â³digo HTML/CSS/JS salvo
  previewData String? // JSON com textos e imagens usados
  version     Int             @default(1)
  generatedAt DateTime        @default(now())

  @@index([status])
}

model WebsiteProposal {
  id         String          @id @default(uuid())
  prospectId String
  prospect   WebsiteProspect @relation(fields: [prospectId], references: [id])
  status     String          @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED
  content    String? // Texto da proposta comercial gerada pela IA
  sentAt     DateTime?
  acceptedAt DateTime?

  @@index([status])
}

model WebsiteProject {
  id              String          @id @default(uuid())
  prospectId      String
  prospect        WebsiteProspect @relation(fields: [prospectId], references: [id])
  status          String          @default("PLANNING") // PLANNING, CODING, REVIEW, PUBLISHED, ARCHIVED
  domainName      String?
  hostingProvider String?
  sourceCodeRepo  String? // Link para o repositÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¾Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¾ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â³rio ou arquivo zip
  currentVersion  Int             @default(1)
  publishedAt     DateTime?

  @@index([status])
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products SupplierProduct[]
}

model SupplierProduct {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  productId  String
  // Nota: Usamos String para productId para vincular ao modelo Product existente

  costPrice    Float // PreÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â§o de custo deste fornecedor
  minQuantity  Int     @default(1) // Quantidade mÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â­nima para este preÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â§o
  leadTimeDays Int     @default(7) // Prazo de entrega em dias
  isPreferred  Boolean @default(false) // Marca o melhor fornecedor

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Product   Product  @relation(fields: [productId], references: [id])

  @@unique([supplierId, productId])
  @@index([productId])
}

model Outreach {
  id        String    @id @default(uuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id])
  channel   String
  message   String
  status    String    @default("PENDING")
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([leadId])
  @@index([status])
}

model FollowUp {
  id             String    @id @default(uuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id])
  sequenceNumber Int       @default(1) // 1, 2, 3...
  scheduledFor   DateTime
  executedAt     DateTime?
  status         String    @default("PENDING") // PENDING, SENT, SKIPPED
  message        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([leadId])
  @@index([status])
  @@index([scheduledFor])
}

model ProductSegment {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  color       String   @default("#2563eb") // Cor para identificar no dashboard
  icon        String   @default("package") // Icone (usar emoji ou nome)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive])
}


model ScheduledPost {
  id           String   @id @default(uuid())
  segmentId    String?
  platform     String   @default("INSTAGRAM")
  content      String
  hashtags     String
  scheduledFor DateTime
  status       String   @default("PENDING")
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model PixPayment {
  id        String   @id @default(uuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  pixCode   String
  qrCodeUrl String
  status    String   @default("PENDING")
  expiresAt DateTime
  paidAt    DateTime?
  createdAt DateTime @default(now())
}

model Business {
  id          String   @id @default(uuid())
  name        String
  category    String?
  address     String?
  city        String?
  state       String?
  phone       String?
  website     String?
  email       String?
  segment     String?
  source      String   @default("MANUAL")
  status      String   @default("NEW")
  score       Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([city])
  @@index([segment])
  @@index([status])
}
model WebsiteCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  templates   WebsiteTemplate[]
}

model WebsiteTemplate {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  categoryId    String
  category      WebsiteCategory @relation(fields: [categoryId], references: [id])
  description   String?
  thumbnailUrl  String?
  demoUrl       String?
  repositoryUrl String?
  sourceType    String   @default("LOCAL")
  price         Float    @default(0)
  active        Boolean  @default(true)
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  demos         WebsiteDemo[]
}

// ==========================================
// MÃ“DULO MERCADO LIVRE - SCHEMA
// ==========================================

model MercadoLivreAccount {
  id                String    @id @default(cuid())
  userId            String    // Relacionamento com seu User/Core existente
  mlUserId          String    @unique
  nickname          String
  siteId            String    @default("MLB")
  permalink         String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  tokens            MercadoLivreToken[]
  items             MercadoLivreItem[]
  orders            MercadoLivreOrder[]
  shipments         MercadoLivreShipment[]
  audits            MercadoLivreAudit[]

  @@map("mercado_livre_accounts")
}

model MercadoLivreToken {
  id                String    @id @default(cuid())
  accountId         String
  account           MercadoLivreAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessToken       String    // Deve ser criptografado na aplicaÃ§Ã£o
  refreshToken      String    // Deve ser criptografado na aplicaÃ§Ã£o
  expiresAt         DateTime
  scope             String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([accountId])
  @@map("mercado_livre_tokens")
}

model MercadoLivreItem {
  id                String    @id @default(cuid())
  accountId         String
  account           MercadoLivreAccount @relation(fields: [accountId], references: [id])
  mlItemId          String    @unique
  productId         String?   // Relacionamento com seu Product/Core existente
  title             String
  status            String    // active, paused, closed, draft
  price             Float
  stock             Int
  permalink         String
  lastSyncedAt      DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([accountId])
  @@index([productId])
  @@map("mercado_livre_items")
}

model MercadoLivreOrder {
  id                String    @id @default(cuid())
  accountId         String
  account           MercadoLivreAccount @relation(fields: [accountId], references: [id])
  mlOrderId         String    @unique
  coreOrderId       String?   // Relacionamento com seu Order/Core existente
  status            String    // paid, cancelled, etc.
  totalAmount       Float
  dateCreated       DateTime
  lastSyncedAt      DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([accountId])
  @@index([coreOrderId])
  @@map("mercado_livre_orders")
}

model MercadoLivreShipment {
  id                String    @id @default(cuid())
  accountId         String
  account           MercadoLivreAccount @relation(fields: [accountId], references: [id])
  mlShipmentId      String    @unique
  mlOrderId         String
  status            String    // ready_to_ship, shipped, delivered
  trackingNumber    String?
  labelUrl          String?
  dateFirstPrinted  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([accountId])
  @@index([mlOrderId])
  @@map("mercado_livre_shipments")
}

model MercadoLivreWebhookEvent {
  id                String    @id @default(cuid())
  topic             String
  resourceId        String
  payload           String
  processed         Boolean   @default(false)
  processedAt       DateTime?
  createdAt         DateTime  @default(now())

  @@index([topic, resourceId])
  @@map("mercado_livre_webhook_events")
}

model MercadoLivreAudit {
  id                String    @id @default(cuid())
  accountId         String
  account           MercadoLivreAccount @relation(fields: [accountId], references: [id])
  action            String
  resource          String
  resourceId        String?
  result            String    // SUCCESS, FAILED
  errorMessage      String?
  requestId         String?
  createdAt         DateTime  @default(now())

  @@index([accountId, createdAt])
  @@map("mercado_livre_audits")
}


// =========================================
// RB FACTORY SITES - HISTORICO DO PROSPECT
// =========================================
model WebsiteProspectEvent {
  id          String          @id @default(uuid())
  prospectId  String
  prospect    WebsiteProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type        String          // PROSPECT_CREATED, QUALIFIED, AUDIT_COMPLETED, DEMO_CREATED, DEMO_UPDATED, CONTACTED, RESPONDED, FOLLOWUP_SCHEDULED, PROPOSAL_CREATED, PROPOSAL_SENT, NEGOTIATION_STARTED, PAYMENT_RECEIVED, PRODUCTION_STARTED, DELIVERED, SUBSCRIPTION_STARTED, LOST
  description String?
  metadata    String?         // JSON com dados adicionais do evento
  userId      String?         // quem executou a acao
  createdAt   DateTime        @default(now())

  @@index([prospectId])
  @@index([type])
  @@index([createdAt])
}
// =========================================
// RB FACTORY SITES - PLANOS DE PRECOS
// =========================================
model WebsitePlan {
  id              String            @id @default(uuid())
  code            String            @unique // ESSENCIAL, PROFISSIONAL, PREMIUM, SOB_MEDIDA
  name            String
  description     String?
  projectPrice    Float?            // Preco do projeto (setup)
  monthlyPrice    Float?            // Mensalidade (manutencao)
  features        String?           // JSON com lista de features
  active          Boolean           @default(true)
  position        Int               @default(0) // ordem de exibicao
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  prospects       WebsiteProspect[] @relation("ProspectSelectedPlan")

  @@index([code])
}
// =========================================
// RB FACTORY SITES - MENSALIDADES
// =========================================
model WebsiteSubscription {
  id              String          @id @default(uuid())
  prospectId      String
  prospect        WebsiteProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  planId          String?
  planCode        String?         // ESSENCIAL, PROFISSIONAL, PREMIUM, SOB_MEDIDA
  amount          Float
  status          String          @default("PENDING") // PENDING, ACTIVE, PAUSED, CANCELLED, OVERDUE
  billingDay      Int             @default(1) // dia do mes
  startDate       DateTime        @default(now())
  nextBillingDate DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([prospectId])
  @@index([status])
  @@index([nextBillingDate])
}

