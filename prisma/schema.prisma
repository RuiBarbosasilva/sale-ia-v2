  @@index([active])
  @@index([segment])
  @@index([favorite])
  @@index([usageCount])
}

// ==========================================
// MÃ“DULO AFILIADOS IA - TransaÃ§Ãµes e IdempotÃªncia
// ==========================================
model AffiliateTransaction {
  id                String          @id @default(uuid())
  externalId        String          @unique // ID da transaÃ§Ã£o na plataforma (ex: receipt)
  provider          String // 'clickbank', 'hotmart', etc.
  afiliadoProdutoId String
  produto           AfiliadoProduto @relation(fields: [afiliadoProdutoId], references: [id])
  amount            Float // Valor total da venda
  commission        Float // Valor da comissÃ£o recebida
  status            String // 'PENDING', 'CONFIRMED', 'REFUNDED', 'CANCELLED'
  rawPayload        String // Salva o payload bruto como texto (SQLite compatÃ­vel)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([provider, externalId])
}

// ==========================================
// MÃ“DULO AFILIADOS IA - Produto/Oferta
// ==========================================
model AfiliadoProduto {
  id                 String                 @id @default(uuid())
  plataforma         String
  produtoIdExterno   String?
  nome               String
  categoria          String?
  tipo               String
  preco              Float
  comissaoPercentual Float
  linkAfiliado       String
  thumbnail          String?
  temperatura        Float?
  score              Float
  status             String                 @default("ativo")
  vendasConfirmadas  Int                    @default(0)
  comissaoTotal      Float                  @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  copies             AfiliadoCopy[]
  publicacoes        AfiliadoPublicacao[]
  AfiliadoCriativo   AfiliadoCriativo[]
  transactions       AffiliateTransaction[]
}

// ==========================================
// MÃ“DULO AFILIADOS IA - Copy/ConteÃºdo
// ==========================================
model AfiliadoCopy {
  id        String          @id @default(uuid())
  produtoId String
  produto   AfiliadoProduto @relation(fields: [produtoId], references: [id])
  tipo              String?
  conteudo          String?
  canal     String?
  status    String          @default("ativo")
  createdAt DateTime        @default(now())
  updatedAt         DateTime? @updatedAt
}

// ==========================================
// MÃ“DULO AFILIADOS IA - PublicaÃ§Ã£o/Campanha
// ==========================================
model AfiliadoPublicacao {
  id                String            @id @default(uuid())
  produtoId         String
  produto           AfiliadoProduto   @relation(fields: [produtoId], references: [id])
  canal             String
  postIdExterno     String?
  dataPublicacao    DateTime?
  impressoes        Int               @default(0)
  cliques           Int               @default(0)
  comentarios       Int               @default(0)
  dmsEnviados       Int               @default(0)
  vendasConfirmadas Int               @default(0)
  comissaoGerada    Float             @default(0)
  status            String            @default("agendado")
  criativoId        String?
  criativo          AfiliadoCriativo? @relation(fields: [criativoId], references: [id])
}

// ==========================================
// MÃ“DULO AFILIADOS IA - Criativo/MÃ­dia
// ==========================================
model AfiliadoCriativo {
  id          String               @id @default(uuid())
  produtoId   String
  produto     AfiliadoProduto      @relation(fields: [produtoId], references: [id])
  tipo              String?
  url               String?
  descricao   String?
  status      String               @default("ativo")
  createdAt   DateTime             @default(now())
  updatedAt         DateTime? @updatedAt
  publicacoes AfiliadoPublicacao[]
}
