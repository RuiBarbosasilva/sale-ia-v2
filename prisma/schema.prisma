model MercadoLivreAccount {
  id        String   @id @default(cuid())
  userId    String // Relacionamento com seu User/Core existente
  mlUserId  String   @unique
  nickname  String
  siteId    String   @default("MLB")
  permalink String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tokens    MercadoLivreToken[]
  items     MercadoLivreItem[]
  orders    MercadoLivreOrder[]
  shipments MercadoLivreShipment[]
  audits    MercadoLivreAudit[]

  @@map("mercado_livre_accounts")
}

model MercadoLivreToken {
  id           String              @id @default(cuid())
  accountId    String
  account      MercadoLivreAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessToken  String // Deve ser criptografado na aplicaÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o
  refreshToken String // Deve ser criptografado na aplicaÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o
  expiresAt    DateTime
  scope        String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([accountId])
  @@map("mercado_livre_tokens")
}

model MercadoLivreItem {
  id           String              @id @default(cuid())
  accountId    String
  account      MercadoLivreAccount @relation(fields: [accountId], references: [id])
  mlItemId     String              @unique
  productId    String? // Relacionamento com seu Product/Core existente
  title        String
  status       String // active, paused, closed, draft
  price        Float
  stock        Int
  permalink    String
  lastSyncedAt DateTime            @default(now())
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([accountId])
  @@index([productId])
  @@map("mercado_livre_items")
}

model MercadoLivreOrder {
  id           String              @id @default(cuid())
  accountId    String
  account      MercadoLivreAccount @relation(fields: [accountId], references: [id])
  mlOrderId    String              @unique
  coreOrderId  String? // Relacionamento com seu Order/Core existente
  status       String // paid, cancelled, etc.
  totalAmount  Float
  dateCreated  DateTime
  lastSyncedAt DateTime            @default(now())
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([accountId])
  @@index([coreOrderId])
  @@map("mercado_livre_orders")
}

model MercadoLivreShipment {
  id               String              @id @default(cuid())
  accountId        String
  account          MercadoLivreAccount @relation(fields: [accountId], references: [id])
  mlShipmentId     String              @unique
  mlOrderId        String
  status           String // ready_to_ship, shipped, delivered
  trackingNumber   String?
  labelUrl         String?
  dateFirstPrinted DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([accountId])
  @@index([mlOrderId])
  @@map("mercado_livre_shipments")
}

model MercadoLivreWebhookEvent {
  id          String    @id @default(cuid())
  topic       String
  resourceId  String
  payload     String
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([topic, resourceId])
  @@map("mercado_livre_webhook_events")
}

model MercadoLivreAudit {
  id           String              @id @default(cuid())
  accountId    String
  account      MercadoLivreAccount @relation(fields: [accountId], references: [id])
  action       String
  resource     String
  resourceId   String?
  result       String // SUCCESS, FAILED
  errorMessage String?
  requestId    String?
  createdAt    DateTime            @default(now())

  @@index([accountId, createdAt])
  @@map("mercado_livre_audits")
}

// =========================================
// RB FACTORY SITES - HISTORICO DO PROSPECT
// =========================================
model WebsiteProspectEvent {
  id          String          @id @default(uuid())
  prospectId  String
  prospect    WebsiteProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type        String // PROSPECT_CREATED, QUALIFIED, AUDIT_COMPLETED, DEMO_CREATED, DEMO_UPDATED, CONTACTED, RESPONDED, FOLLOWUP_SCHEDULED, PROPOSAL_CREATED, PROPOSAL_SENT, NEGOTIATION_STARTED, PAYMENT_RECEIVED, PRODUCTION_STARTED, DELIVERED, SUBSCRIPTION_STARTED, LOST
  description String?
  metadata    String? // JSON com dados adicionais do evento
  userId      String? // quem executou a acao
  createdAt   DateTime        @default(now())

  @@index([prospectId])
  @@index([type])
  @@index([createdAt])
}

// =========================================
// RB FACTORY SITES - PLANOS DE PRECOS
// =========================================
model WebsitePlan {
  id           String   @id @default(uuid())
  code         String   @unique // ESSENCIAL, PROFISSIONAL, PREMIUM, SOB_MEDIDA
  name         String
  description  String?
  projectPrice Float? // Preco do projeto (setup)
  monthlyPrice Float? // Mensalidade (manutencao)
  features     String? // JSON com lista de features
  active       Boolean  @default(true)
  position     Int      @default(0) // ordem de exibicao
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prospects WebsiteProspect[] @relation("ProspectSelectedPlan")

  @@index([code])
}

// =========================================
// RB FACTORY SITES - MENSALIDADES
// =========================================
model WebsiteSubscription {
  id              String          @id @default(uuid())
  prospectId      String
  prospect        WebsiteProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  planId          String?
  planCode        String? // ESSENCIAL, PROFISSIONAL, PREMIUM, SOB_MEDIDA
  amount          Float
  status          String          @default("PENDING") // PENDING, ACTIVE, PAUSED, CANCELLED, OVERDUE
  billingDay      Int             @default(1) // dia do mes
  startDate       DateTime        @default(now())
  nextBillingDate DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([prospectId])
  @@index([status])
  @@index([nextBillingDate])
}

