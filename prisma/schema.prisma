generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Lead {
  id        String   @id @default(uuid())
  name      String?
  phone     String?  @unique
  email     String?  @unique
  status    String   @default("NEW_LEAD")
  stage     String   @default("NEW")
  score     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages        Message[]
  quotes          Quote[]
  orders          Order[]
  sales           Sale[]
  payments        Payment[]
  CampaignLead    CampaignLead[]
  CampaignMessage CampaignMessage[]
  Outreach        Outreach[]
  FollowUp        FollowUp[]
}

model Product {
  segmentId   String?
  id          String          @id @default(uuid())
  name        String
  description String?
  costPrice   Float
  salePrice   Float
  sku         String?
  stock       Int             @default(0)
  active      Boolean         @default(true)
  segment     ProductSegment? @relation(fields: [segmentId], references: [id])
  niche       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  quotes     Quote[]
  orderItems OrderItem[]

  supplierProducts SupplierProduct[]
}

model Quote {
  id         String   @id @default(uuid())
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id])
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  quantity   Int      @default(1)
  unitPrice  Float    @default(0)
  totalValue Float?
  discount   Float    @default(0)
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders   Order[]
  payments Payment[]
}

model Order {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id])
  quoteId    String?
  quote      Quote?   @relation(fields: [quoteId], references: [id])
  totalValue Float?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items      OrderItem[]
  payments   Payment[]
  pixPayment PixPayment?
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  total     Float
}

model Message {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  sender    String
  content   String
  createdAt DateTime @default(now())
}

model Sale {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  value     Float
  status    String   @default("COMPLETED")
  createdAt DateTime @default(now())
}

model Payment {
  id            String    @id @default(uuid())
  leadId        String
  lead          Lead      @relation(fields: [leadId], references: [id])
  orderId       String?
  order         Order?    @relation(fields: [orderId], references: [id])
  quoteId       String?
  quote         Quote?    @relation(fields: [quoteId], references: [id])
  amount        Float
  status        String    @default("PENDING")
  provider      String    @default("MANUAL")
  transactionId String?   @unique
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Campaign {
  id             String    @id @default(uuid())
  name           String
  type           String
  segment        String?
  channel        String
  status         String    @default("DRAFT")
  dailyLimit     Int       @default(100)
  frequencyLimit Int       @default(1)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  leads    CampaignLead[]
  messages CampaignMessage[]
}

model CampaignLead {
  id         String    @id @default(uuid())
  campaignId String
  leadId     String
  status     String    @default("PENDING")
  sentAt     DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id])
  lead     Lead     @relation(fields: [leadId], references: [id])

  @@unique([campaignId, leadId])
}

model CampaignMessage {
  id          String    @id @default(uuid())
  campaignId  String
  leadId      String
  channel     String
  content     String
  status      String    @default("QUEUED")
  messageId   String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
  lead     Lead     @relation(fields: [leadId], references: [id])
}

// ==========================================================
// MODULO DE SITES (separado do modulo de brindes)
// ==========================================================

model WebsiteProspect {
  id             String  @id @default(uuid())
  companyName    String
  segment        String?
  city           String?
  state          String?
  phone          String?
  email          String?
  currentWebsite String?
  websiteStatus  String  @default("UNKNOWN") // NO_WEBSITE, HAS_WEBSITE, WEBSITE_POOR
  websiteScore   Int     @default(0)

  // Controle do Fluxo de Site
  status     String  @default("DISCOVERED") // DISCOVERED, QUALIFIED, DEMO_READY, PROPOSAL_SENT, ACCEPTED, REJECTED, ARCHIVED
  score      Int     @default(0)
  scoreGrade String? // A, B, C, D

// MODULO DE SITES - MODELOS E RELACOES
  linkedLeadId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  demos     WebsiteDemo[]
  rbFactoryClients RbFactorySiteClient[]
  proposals WebsiteProposal[]
  projects  WebsiteProject[]

  // =========================================
  // RB FACTORY SITES - CAMPOS COMERCIAIS
  // =========================================
  address          String?
  whatsapp         String?
  instagram        String?
  facebook         String?
  googleMapsUrl    String?
  description      String?
  businessHours    String?
  reviewCount      Int       @default(0)
  rating           Float?    @default(0)
  photoCount       Int       @default(0)
  source           String?
  sourceUrl        String?
  prospectingDate  DateTime  @default(now())
  priority         String    @default("NORMAL")
  notes            String?
  contactPerson    String?
  contactedAt      DateTime?
  lastContactAt    DateTime?
  nextFollowUpAt   DateTime?
  lostReason       String?
  estimatedValue   Float?
  selectedPlanId   String?
  auditData        String?
  auditPerformedAt DateTime?

  // RB Factory Sites - Relacoes comerciais
  selectedPlan  WebsitePlan?           @relation("ProspectSelectedPlan", fields: [selectedPlanId], references: [id])
  events        WebsiteProspectEvent[]
  subscriptions WebsiteSubscription[]

  // =========================================
  // RB FACTORY SITES - CAMPOS COMERCIAIS
  // =========================================

  // RB Factory - Campos de prospeccao
  businessName        String?
  legalName           String?
  lastAuditAt         DateTime?
  lastEnrichedAt      DateTime?
  emailStatus         String?   @default("NOT_READY")
  demoStatus          String?   @default("NONE")
  prospectingMetadata String?
  identityData        String?
  researchData        String?
  outreachData        String?

  // RB Factory - Campos de prospeccao
  category                 String?
  subcategory              String?
  postalCode               String?
  providerPlaceId          String?
  country                  String? @default("BR")
  websiteOpportunityStatus String? @default("UNKNOWN")
  websiteOpportunityScore  Int?    @default(0)
  websiteHealthScore       Int?    @default(0)
  searchId                 String?

  // RB Factory - Relations
  search     WebsiteProspectingSearch? @relation(fields: [searchId], references: [id])
  identity   WebsiteBrandIdentity?
  outreaches WebsiteOutreach[]

  @@index([status])
  @@index([score])
}

model WebsiteDemo {
  templateId  String?
  template    WebsiteTemplate? @relation(fields: [templateId], references: [id])
  id          String           @id @default(uuid())
  prospectId  String
  prospect    WebsiteProspect  @relation(fields: [prospectId], references: [id])
  status      String           @default("PENDING") // PENDING, READY, REVISION
  sourceCode  String? // Codigo HTML/CSS/JS salvo
  previewData String? // JSON com textos e imagens usados
  version     Int              @default(1)
  generatedAt DateTime         @default(now())

  @@index([status])
}

model WebsiteProposal {
  id         String          @id @default(uuid())
  prospectId String
  prospect   WebsiteProspect @relation(fields: [prospectId], references: [id])
  status     String          @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED
  content    String? // Texto da proposta comercial gerada pela IA
  sentAt     DateTime?
  acceptedAt DateTime?

  @@index([status])
}

model WebsiteProject {
  id              String          @id @default(uuid())
  prospectId      String
  prospect        WebsiteProspect @relation(fields: [prospectId], references: [id])
  status          String          @default("PLANNING") // PLANNING, CODING, REVIEW, PUBLISHED, ARCHIVED
  domainName      String?
  hostingProvider String?
  sourceCodeRepo  String?
  publicUrl       String?
  hostingSiteId   String?
  hostingDeployId String? // Link para o repositorio de hospedagem
  currentVersion  Int             @default(1)
  publishedAt     DateTime?

  @@index([status])
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products SupplierProduct[]
}

model SupplierProduct {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  productId  String
  // Nota: Usamos String para productId para vincular ao modelo Product existente

  costPrice    Float // Preco de custo deste fornecedor
  minQuantity  Int     @default(1) // Quantidade minima para este produto
  leadTimeDays Int     @default(7) // Prazo de entrega em dias
  isPreferred  Boolean @default(false) // Marca o melhor fornecedor

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Product   Product  @relation(fields: [productId], references: [id])

  @@unique([supplierId, productId])
  @@index([productId])
}

model Outreach {
  id        String    @id @default(uuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id])
  channel   String
  message   String
  status    String    @default("PENDING")
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([leadId])
  @@index([status])
}

model FollowUp {
  id             String    @id @default(uuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id])
  sequenceNumber Int       @default(1) // 1, 2, 3...
  scheduledFor   DateTime
  executedAt     DateTime?
  status         String    @default("PENDING") // PENDING, SENT, SKIPPED
  message        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([leadId])
  @@index([status])
  @@index([scheduledFor])
}

model ProductSegment {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  color       String   @default("#2563eb") // Cor para identificar no dashboard
  icon        String   @default("package") // Icone (usar emoji ou nome)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive])
}

model ScheduledPost {
  id           String    @id @default(uuid())
  segmentId    String?
  platform     String    @default("INSTAGRAM")
  content      String
  hashtags     String
  scheduledFor DateTime
  status       String    @default("PENDING")
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PixPayment {
  id        String    @id @default(uuid())
  orderId   String    @unique
  order     Order     @relation(fields: [orderId], references: [id])
  pixCode   String
  qrCodeUrl String
  status    String    @default("PENDING")
  expiresAt DateTime
  paidAt    DateTime?
  createdAt DateTime  @default(now())
}

model Business {
  id        String   @id @default(uuid())
  name      String
  category  String?
  address   String?
  city      String?
  state     String?
  phone     String?
  website   String?
  email     String?
  segment   String?
  source    String   @default("MANUAL")
  status    String   @default("NEW")
  score     Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([segment])
  @@index([status])
}

model WebsiteCategory {
  id          String            @id @default(cuid())
  name        String            @unique
  slug        String            @unique
  description String?
  icon        String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  templates   WebsiteTemplate[]
}

model WebsiteTemplate {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  categoryId    String
  category      WebsiteCategory @relation(fields: [categoryId], references: [id])
  description   String?
  thumbnailUrl  String?
  demoUrl       String?
  repositoryUrl String?
  sourceType    String          @default("LOCAL")
  price         Float           @default(0)
  active        Boolean         @default(true)
  featured      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  demos         WebsiteDemo[]
}

// ==========================================
// MODULO MERCADO LIVRE - SCHEMA
// ==========================================

model MercadoLivreAccount {
  id        String   @id @default(cuid())
  userId    String // Relacionamento com seu User/Core existente
  mlUserId  String   @unique
  nickname  String
  siteId    String   @default("MLB")
  permalink String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tokens    MercadoLivreToken[]
  items     MercadoLivreItem[]
  orders    MercadoLivreOrder[]
  shipments MercadoLivreShipment[]
  audits    MercadoLivreAudit[]

  @@map("mercado_livre_accounts")
}

model MercadoLivreToken {
  id           String              @id @default(cuid())
  accountId    String
  account      MercadoLivreAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessToken  String // Deve ser criptografado na aplicacao
  refreshToken String // Deve ser criptografado na aplicacao
  expiresAt    DateTime
  scope        String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([accountId])
  @@map("mercado_livre_tokens")
}

model MercadoLivreItem {
  id           String              @id @default(cuid())
  accountId    String
  account      MercadoLivreAccount @relation(fields: [accountId], references: [id])
  mlItemId     String              @unique
  productId    String? // Relacionamento com seu Product/Core existente
  title        String
  status       String // active, paused, closed, draft
  price        Float
  stock        Int
  permalink    String
  lastSyncedAt DateTime            @default(now())
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([accountId])
  @@index([productId])
  @@map("mercado_livre_items")
}

model MercadoLivreOrder {
  id           String              @id @default(cuid())
  accountId    String
  account      MercadoLivreAccount @relation(fields: [accountId], references: [id])
  mlOrderId    String              @unique
  coreOrderId  String? // Relacionamento com seu Order/Core existente
  status       String // paid, cancelled, etc.
  totalAmount  Float
  dateCreated  DateTime
  lastSyncedAt DateTime            @default(now())
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([accountId])
  @@index([coreOrderId])
  @@map("mercado_livre_orders")
}

model MercadoLivreShipment {
  id               String              @id @default(cuid())
  accountId        String
  account          MercadoLivreAccount @relation(fields: [accountId], references: [id])
  mlShipmentId     String              @unique
  mlOrderId        String
  status           String // ready_to_ship, shipped, delivered
  trackingNumber   String?
  labelUrl         String?
  dateFirstPrinted DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([accountId])
  @@index([mlOrderId])
  @@map("mercado_livre_shipments")
}

model MercadoLivreWebhookEvent {
  id          String    @id @default(cuid())
  topic       String
  resourceId  String
  payload     String
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([topic, resourceId])
  @@map("mercado_livre_webhook_events")
}

model MercadoLivreAudit {
  id           String              @id @default(cuid())
  accountId    String
  account      MercadoLivreAccount @relation(fields: [accountId], references: [id])
  action       String
  resource     String
  resourceId   String?
  result       String // SUCCESS, FAILED
  errorMessage String?
  requestId    String?
  createdAt    DateTime            @default(now())

  @@index([accountId, createdAt])
  @@map("mercado_livre_audits")
}

// =========================================
// RB FACTORY SITES - HISTORICO DO PROSPECT
// =========================================
model WebsiteProspectEvent {
  id          String          @id @default(uuid())
  prospectId  String
  prospect    WebsiteProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type        String // PROSPECT_CREATED, QUALIFIED, AUDIT_COMPLETED, DEMO_CREATED, DEMO_UPDATED, CONTACTED, RESPONDED, FOLLOWUP_SCHEDULED, PROPOSAL_CREATED, PROPOSAL_SENT, NEGOTIATION_STARTED, PAYMENT_RECEIVED, PRODUCTION_STARTED, DELIVERED, SUBSCRIPTION_STARTED, LOST
  description String?
  metadata    String? // JSON com dados adicionais do evento
  userId      String? // quem executou a acao
  createdAt   DateTime        @default(now())

  @@index([prospectId])
  @@index([type])
  @@index([createdAt])
}

// =========================================
// RB FACTORY SITES - PLANOS DE PRECOS
// =========================================
model WebsitePlan {
  id           String   @id @default(uuid())
  code         String   @unique // ESSENCIAL, PROFISSIONAL, PREMIUM, SOB_MEDIDA
  name         String
  description  String?
  projectPrice Float? // Preco do projeto (setup)
  monthlyPrice Float? // Mensalidade (manutencao)
  features     String? // JSON com lista de features
  active       Boolean  @default(true)
  position     Int      @default(0) // ordem de exibicao
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prospects WebsiteProspect[] @relation("ProspectSelectedPlan")

  @@index([code])
}

// =========================================
// RB FACTORY SITES - MENSALIDADES
// =========================================
model WebsiteSubscription {
  id              String          @id @default(uuid())
  prospectId      String
  prospect        WebsiteProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  planId          String?
  planCode        String? // ESSENCIAL, PROFISSIONAL, PREMIUM, SOB_MEDIDA
  amount          Float
  status          String          @default("PENDING") // PENDING, ACTIVE, PAUSED, CANCELLED, OVERDUE
  billingDay      Int             @default(1) // dia do mes
  startDate       DateTime        @default(now())
  nextBillingDate DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([prospectId])
  @@index([status])
  @@index([nextBillingDate])
}

// ============================================================
// RB FACTORY - PROSPECCAO COMERCIAL
// ============================================================

model WebsiteProspectingSearch {
  id             String            @id @default(uuid())
  region         String?
  state          String?
  city           String?
  country        String            @default("BR")
  niche          String
  subniche       String?
  query          String?
  status         String            @default("PENDING")
  provider       String            @default("GOOGLE_PLACES")
  totalFound     Int               @default(0)
  totalQualified Int               @default(0)
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  prospects      WebsiteProspect[]

  @@index([city])
  @@index([niche])
  @@index([status])
}

model WebsiteBrandIdentity {
  id                 String          @id @default(uuid())
  prospectId         String          @unique
  prospect           WebsiteProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  logoUrl            String?
  primaryColor       String?
  secondaryColor     String?
  accentColor        String?
  fontSuggestions    String?
  visualStyle        String?
  photoStyle         String?
  toneOfVoice        String?
  identityConfidence String          @default("UNKNOWN")
  sources            String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model WebsiteDemoJob {
  id           String    @id @default(uuid())
  prospectId   String
  status       String    @default("QUEUED")
  priority     Int       @default(5)
  progress     Int       @default(0)
  currentStage String?
  error        String?
  demoId       String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([prospectId])
}

model WebsiteOutreach {
  id             String                 @id @default(uuid())
  prospectId     String
  prospect       WebsiteProspect        @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  channel        String                 @default("EMAIL")
  status         String                 @default("NOT_READY")
  subject        String?
  body           String?
  recipient      String?
  idempotencyKey String?                @unique
  messageId      String?
  provider       String?
  sentAt         DateTime?
  error          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  events         WebsiteOutreachEvent[]

  @@index([prospectId])
  @@index([status])
}

model WebsiteOutreachEvent {
  id          String          @id @default(uuid())
  outreachId  String
  outreach    WebsiteOutreach @relation(fields: [outreachId], references: [id], onDelete: Cascade)
  type        String
  description String?
  metadata    String?
  createdAt   DateTime        @default(now())

  @@index([outreachId])
}

// ============================================================

// ============================================================
// SALE-IA-V2 - MÓDULO DE AFILIADOS (UNIFICADO + IA)
// ============================================================

model Affiliate {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  phone           String?
  slug            String    @unique
  status          String    @default("PENDING")
  commissionRate  Float     @default(10)
  accessTokenHash String?   @unique
  lastLoginAt     DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  links       AffiliateLink[]
  clicks      AffiliateClick[]
  sales       AffiliateSale[]
  payouts     AffiliatePayout[]
  transactions AffiliateTransaction[]
}

model AffiliateLink {
  id             String          @id @default(uuid())
  affiliateId    String
  affiliate      Affiliate       @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  offerId        String?
  code           String          @unique
  destinationUrl String
  campaign       String?
  active         Boolean         @default(true)
  clickCount     Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  offer  AffiliateOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  clicks AffiliateClick[]
  sales  AffiliateSale[]

  @@index([affiliateId])
  @@index([active])
}

model AffiliateClick {
  id          String        @id @default(uuid())
  affiliateId String
  affiliate   Affiliate     @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  linkId      String
  link        AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  ipHash      String?
  userAgent   String?
  referer     String?
  createdAt   DateTime      @default(now())

  @@index([affiliateId, createdAt])
  @@index([linkId, createdAt])
}

model AffiliateSale {
  id               String          @id @default(uuid())
  affiliateId      String
  affiliate        Affiliate       @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  linkId           String?
  link             AffiliateLink?  @relation(fields: [linkId], references: [id], onDelete: SetNull)
  externalOrderId  String?         @unique
