  updatedAt       DateTime  @updatedAt

  links   AffiliateLink[]
  clicks  AffiliateClick[]
  sales   AffiliateSale[]
  payouts AffiliatePayout[]
}

model AffiliateOffer {
  id             String   @id @default(uuid())
  name           String
  network        String?
  externalId     String?
  destinationUrl String
  category       String?
  commissionRate Float    @default(10)
  active         Boolean  @default(true)
  metadata       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  links AffiliateLink[]

  @@index([network])
  @@index([active])
}

model AffiliateLink {
  id             String          @id @default(uuid())
  affiliateId    String
  affiliate      Affiliate       @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  offerId        String?
  offer          AffiliateOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  code           String          @unique
  destinationUrl String
  campaign       String?
  active         Boolean         @default(true)
  clickCount     Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  clicks AffiliateClick[]
  sales  AffiliateSale[]

  @@index([affiliateId])
  @@index([offerId])
  @@index([active])
}

model AffiliateClick {
  id          String        @id @default(uuid())
  affiliateId String
  affiliate   Affiliate     @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  linkId      String
  link        AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  ipHash      String?
  userAgent   String?
  referer     String?
  createdAt   DateTime      @default(now())

  @@index([affiliateId, createdAt])
  @@index([linkId, createdAt])
}

model AffiliateSale {
  id               String                @id @default(uuid())
  affiliateId      String
  affiliate        Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  linkId           String?
  link             AffiliateLink?        @relation(fields: [linkId], references: [id], onDelete: SetNull)
  externalOrderId  String?               @unique
  webhookEventId   String?               @unique
  source           String                @default("MANUAL")
  customerRef      String?
  amount           Float
  commissionRate   Float
  commissionAmount Float
  status           String                @default("PENDING") // PENDING, APPROVED, REJECTED, PAID
  metadata         String?
  createdAt        DateTime              @default(now())
  approvedAt       DateTime?
  paidAt           DateTime?
  payoutItems      AffiliatePayoutItem[]

  @@index([affiliateId, status])
  @@index([createdAt])
}

model AffiliatePayout {
  id          String                @id @default(uuid())
  affiliateId String
  affiliate   Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount      Float
  status      String                @default("REQUESTED") // REQUESTED, PROCESSING, PAID, REJECTED
  method      String?
  reference   String?
  notes       String?
  requestedAt DateTime              @default(now())
  paidAt      DateTime?
  items       AffiliatePayoutItem[]

  @@index([affiliateId, status])
  @@index([requestedAt])
}

model AffiliatePayoutItem {
  id        String          @id @default(uuid())
  payoutId  String
  payout    AffiliatePayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  saleId    String
  sale      AffiliateSale   @relation(fields: [saleId], references: [id], onDelete: Restrict)
  amount    Float
  createdAt DateTime        @default(now())

  @@unique([payoutId, saleId])
  @@unique([saleId])
  @@index([saleId])
  @@index([payoutId])
}

// ============================================================
// SALE-IA-V2 - AI SALES / AFFILIATE INTELLIGENCE
// Motor de descoberta, avaliacao, campanhas, conteudo e acoes.
// ============================================================

model AffiliateNetwork {
  id                   String    @id @default(uuid())
  name                 String    @unique
  slug                 String    @unique
  type                 String    @default("AFFILIATE_NETWORK")
  baseUrl              String?
  status               String    @default("CONFIGURED")
  apiBaseUrl           String?
  credentialStatus     String    @default("NOT_CONFIGURED")
  credentialsEncrypted String?
  metadata             String?
  active               Boolean   @default(true)
  lastScanAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  products AffiliateProduct[]
  actions  AffiliateAction[]

  @@index([active])
  @@index([status])
}

model AffiliateProduct {
  id                String           @id @default(uuid())
  networkId         String
  network           AffiliateNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  externalId        String?
  name              String
  url               String?
  affiliateUrl      String?
  category          String?
  subcategory       String?
  price             Float?
  commissionRate    Float?
  commissionAmount  Float?
  recurring         Boolean          @default(false)
  gravity           Float?
  popularityScore   Float?
  demandScore       Float?
  competitionScore  Float?
  contentScore      Float?
  conversionScore   Float?
  saturationScore   Float?
  opportunityScore  Float            @default(0)
  status            String           @default("DISCOVERED")
  affiliationStatus String           @default("NOT_AFFILIATED")
  affiliationMode   String           @default("MANUAL")
  description       String?
  salesPageUrl      String?
  metadata          String?
  lastScannedAt     DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  scores        AffiliateProductScore[]
  opportunities AffiliateOpportunity[]
  campaigns     AffiliateCampaign[]

  @@unique([networkId, externalId])
  @@index([networkId])
  @@index([status])
  @@index([opportunityScore])
  @@index([category])
}

model AffiliateProductScore {
  id          String           @id @default(uuid())
  productId   String
  product     AffiliateProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  score       Float
  demand      Float?
  competition Float?
  commission  Float?
  contentFit  Float?
  trend       Float?
  reasoning   String?
  createdAt   DateTime         @default(now())

  @@index([productId, createdAt])
}

model AffiliateOpportunity {
  id             String           @id @default(uuid())
  productId      String
  product        AffiliateProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  score          Float
  status         String           @default("NEW")
  recommendation String?
  strategy       String?
  requiresAction Boolean          @default(false)
  actionType     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([score])
}

model AffiliateCampaign {
  id             String           @id @default(uuid())
  productId      String
  product        AffiliateProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  objective      String           @default("SALES")
  strategy       String?
  targetAudience String?
  status         String           @default("DRAFT")
  budget         Float?
  landingPageUrl String?
  trackingCode   String?
  metrics        String?
  startedAt      DateTime?
  pausedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  contents AffiliateContent[]
  actions  AffiliateAction[]

  @@index([productId])
  @@index([status])
}

model AffiliateContent {
  id           String            @id @default(uuid())
  campaignId   String
  campaign     AffiliateCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  platform     String
  type         String
  angle        String?
  hook         String?
  title        String?
  body         String?
  cta          String?
  hashtags     String?
  mediaPrompt  String?
  mediaUrl     String?
  status       String            @default("DRAFT")
  scheduledFor DateTime?
  publishedAt  DateTime?
  metrics      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([campaignId])
  @@index([platform, status])
}

model AffiliateAction {
  id               String             @id @default(uuid())
  networkId        String?
  network          AffiliateNetwork?  @relation(fields: [networkId], references: [id], onDelete: SetNull)
  campaignId       String?
  campaign         AffiliateCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type             String
  status           String             @default("PENDING_APPROVAL")
  title            String
  description      String?
  payload          String?
  result           String?
  requiresApproval Boolean            @default(true)
  executedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
  @@index([type])
}

// ==========================================================
// EDITORIAL FACTORY / KDP - PIPELINE COMERCIAL
// ==========================================================

model EditorialResearch {
  id          String   @id @default(uuid())
  topic       String
  market      String   @default("BR")
  language    String   @default("pt-BR")
  sourceType  String
  sourceUrl   String?
  sourceTitle String?
  snippet     String?
  data        String?
  capturedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([topic])
  @@index([market, capturedAt])
}

model EditorialOpportunity {
  id               String   @id @default(uuid())
  topic            String
  productType      String   @default("EBOOK")
  market           String   @default("BR")
  language         String   @default("pt-BR")
  audience         String?
  demandScore      Float    @default(0)
  trendScore       Float    @default(0)
  competitionScore Float    @default(0)
  saturationScore  Float    @default(0)
  commercialScore  Float    @default(0)
  opportunityScore Float    @default(0)
  reasoning        String?
  status           String   @default("NEW")
  researchIds      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  projects EditorialProject[]

  @@index([opportunityScore])
  @@index([status])
  @@index([topic])
}

model EditorialProject {
  id                 String                @id @default(uuid())
  opportunityId      String?
  opportunity        EditorialOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  productType        String                @default("EBOOK")
  status             String                @default("RESEARCHED")
  language           String                @default("pt-BR")
  market             String                @default("BR")
  title              String?
  subtitle           String?
  author             String?
  series             String?
  volume             Int?
  audience           String?
  description        String?
  manuscript         String?
  metadata           String?
  manuscriptPath     String?
  coverPath          String?
  interiorPath       String?
  epubPath           String?
  pdfPath            String?
  printPdfPath       String?
  qualityScore       Float                 @default(0)
  aiDisclosure       String                @default("AI_ASSISTED")
  rightsNotes        String?
  generationProvider String?
  generationModel    String?
  errorMessage       String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  chapters     EditorialChapter[]
  assets       EditorialAsset[]
  checks       EditorialQualityCheck[]
  publications EditorialPublication[]
  landingPages EditorialLandingPage[]
  metrics      EditorialMetric[]

  @@index([status])
  @@index([productType])
  @@index([qualityScore])
}

model EditorialChapter {
  id        String           @id @default(uuid())
  projectId String
  project   EditorialProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position  Int
  title     String
  content   String
  wordCount Int              @default(0)
  status    String           @default("DRAFT")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([projectId, position])
  @@index([projectId])
}

model EditorialAsset {
  id        String           @id @default(uuid())
  projectId String
  project   EditorialProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  path      String?
  url       String?
  prompt    String?
  altText   String?
  width     Int?
  height    Int?
  checksum  String?
  status    String           @default("GENERATED")
  createdAt DateTime         @default(now())

  @@index([projectId, type])
}

model EditorialQualityCheck {
  id        String           @id @default(uuid())
  projectId String
  project   EditorialProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checkType String
  status    String
  score     Float            @default(0)
  details   String?
  createdAt DateTime         @default(now())

  @@index([projectId, status])
}

model EditorialPublication {
  id          String           @id @default(uuid())
  projectId   String
  project     EditorialProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform    String
  status      String           @default("MANUAL_REQUIRED")
  externalId  String?
  url         String?
  payload     String?
  error       String?
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([projectId, platform])
  @@index([platform, status])
}

model EditorialLandingPage {
  id          String           @id @default(uuid())
  projectId   String
  project     EditorialProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slug        String           @unique
  title       String
  headline    String
  body        String
  ctaText     String
  checkoutUrl String?
  status      String           @default("DRAFT")
  htmlPath    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model EditorialMetric {
  id         String           @id @default(uuid())
  projectId  String
  project    EditorialProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event      String
  platform   String?
  value      Float            @default(0)
  metadata   String?
  occurredAt DateTime         @default(now())

  @@index([projectId, event])
  @@index([occurredAt])
}

// ============================================================
// RB FACTORY - MODELOS HTML/ZIP IMPORTADOS PELO USUARIO
// ============================================================
model WebsiteImportedTemplate {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  segment     String?
  sourceType  String   @default("HTML")
  html        String
  archiveData Bytes?
  active      Boolean  @default(true)
  favorite    Boolean  @default(false)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
