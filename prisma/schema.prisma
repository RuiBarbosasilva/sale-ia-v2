generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Lead {
  id        String   @id @default(uuid())
  name      String?
  phone     String?  @unique
  email     String?  @unique
  status    String   @default("NEW_LEAD")
  stage     String   @default("NEW")
  score     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages        Message[]
  quotes          Quote[]
  orders          Order[]
  sales           Sale[]
  payments        Payment[]
  CampaignLead    CampaignLead[]
  CampaignMessage CampaignMessage[]
  Outreach        Outreach[]
  FollowUp        FollowUp[]
}

model Product {
  segmentId   String?
  id          String          @id @default(uuid())
  name        String
  description String?
  costPrice   Float
  salePrice   Float
  sku         String?
  stock       Int             @default(0)
  active      Boolean         @default(true)
  segment     ProductSegment? @relation(fields: [segmentId], references: [id])
  niche       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  quotes     Quote[]
  orderItems OrderItem[]

  supplierProducts SupplierProduct[]
}

model Quote {
  id         String   @id @default(uuid())
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id])
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  quantity   Int      @default(1)
  unitPrice  Float    @default(0)
  totalValue Float?
  discount   Float    @default(0)
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders   Order[]
  payments Payment[]
}

model Order {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id])
  quoteId    String?
  quote      Quote?   @relation(fields: [quoteId], references: [id])
  totalValue Float?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items      OrderItem[]
  payments   Payment[]
  pixPayment PixPayment?
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  total     Float
}

model Message {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  sender    String
  content   String
  createdAt DateTime @default(now())
}

model Sale {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  value     Float
  status    String   @default("COMPLETED")
  createdAt DateTime @default(now())
}

model Payment {
  id            String    @id @default(uuid())
  leadId        String
  lead          Lead      @relation(fields: [leadId], references: [id])
  orderId       String?
  order         Order?    @relation(fields: [orderId], references: [id])
  quoteId       String?
  quote         Quote?    @relation(fields: [quoteId], references: [id])
  amount        Float
  status        String    @default("PENDING")
  provider      String    @default("MANUAL")
  transactionId String?   @unique
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Campaign {
  id             String    @id @default(uuid())
  name           String
  type           String
  segment        String?
  channel        String
  status         String    @default("DRAFT")
  dailyLimit     Int       @default(100)
  frequencyLimit Int       @default(1)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  leads    CampaignLead[]
  messages CampaignMessage[]
}

model CampaignLead {
  id         String    @id @default(uuid())
  campaignId String
  leadId     String
  status     String    @default("PENDING")
  sentAt     DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id])
  lead     Lead     @relation(fields: [leadId], references: [id])

  @@unique([campaignId, leadId])
}

model CampaignMessage {
  id          String    @id @default(uuid())
  campaignId  String
  leadId      String
  channel     String
  content     String
  status      String    @default("QUEUED")
  messageId   String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
  lead     Lead     @relation(fields: [leadId], references: [id])
}

